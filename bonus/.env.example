# Copier en bonus/.env (ignoré par git) puis : set -a; . bonus/.env; set +a
# Ne jamais versionner de vraies valeurs.
GITLAB_REPO_NAME=mgedrot-argo-demo
GITHUB_REPO_URL=https://github.com/maxg56/mgedrot-argo-demo.git
GITLAB_USER=root
# Optionnel : si vide, le mot de passe est lu depuis le secret Kubernetes
# gitlab-gitlab-initial-root-password
GITLAB_PASS=<A_REMPLIR_LOCALEMENT>
